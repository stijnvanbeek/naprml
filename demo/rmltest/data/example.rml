<rml>
	<head>
		<title>Example</title>
		<style>
			@font-face {
				font-family: Manrope;
				src: fonts/Manrope-Light.otf;
			}
			body {
				position: relative;
				display: block;
				width: 100%;
				height: 100%;
				font-family: Manrope;
				font-size: 12dp;
				color: #ffffff;
				background-color: #202020e0;
				padding: 20dp;
			}
			h1 {
				display: block;
				font-size: 24dp;
				margin-bottom: 10dp;
			}
			p {
				display: block;
				font-size: 16dp;
			}
			button {
				display: inline-block;
				margin-top: 20dp;
				padding: 8dp 16dp;
				background-color: #404040;
				border-radius: 4dp;
				color: #ffffff;
			}
			button:hover {
				background-color: #606060;
				cursor: pointer;
			}
			button:active {
				background-color: #8080c0;
			}
		</style>
	</head>
	<body>
		<h1>Example</h1>
		<p>Hello RmlUi.</p>
		<button id="clickme">Click me</button>
	</body>
</rml>
